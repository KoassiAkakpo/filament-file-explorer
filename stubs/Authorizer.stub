<?php

declare(strict_types=1);

namespace {{ namespace }};

use Koassi\FilamentFileExplorer\Contracts\FileExplorerAuthorizer;
use Koassi\FilamentFileExplorer\Models\Folder;
use Spatie\MediaLibrary\MediaCollections\Models\Media;

class {{ class }} implements FileExplorerAuthorizer
{
    /**
     * $scopeKey identifies which explorer is being accessed:
     *   - standalone page: the configured scope key, e.g. 'library'
     *   - record page:     '{model-kebab}.{id}', e.g. 'project.42'
     */
    public function canAccess(string $scopeKey, int $rootFolderId): bool
    {
        return auth()->check();
    }

    /**
     * Answer all of the keys below: one left out is read as a denial.
     *
     * You do not have to keep this list in step with the package. An ability
     * added later that you do not answer inherits the one it is a variation of
     * — `share` follows `download` — so this method never silently starts
     * denying something. Add a key here to have the last word on it.
     */
    public function abilities(string $scopeKey, int $rootFolderId): array
    {
        $canWrite = auth()->check();

        return [
            'browse'       => true,
            'search'       => true,
            'getInfo'      => true,
            'download'     => true,
            'upload'       => $canWrite,
            'mkdir'        => $canWrite,
            'rename'       => $canWrite,
            'move'         => $canWrite,
            'copy'         => $canWrite,
            'delete'       => $canWrite,
            'deleteFolder' => $canWrite,
        ];
    }

    public function mediaDeleteState(string $scopeKey, Media $media): array
    {
        return [
            'allowed'           => true,
            'reason_code'       => null,
            'reason'            => null,
            'remaining_seconds' => null,
            'window_seconds'    => 0,
        ];
    }

    public function folderDeleteState(string $scopeKey, Folder $folder): array
    {
        return [
            'allowed'           => true,
            'reason_code'       => null,
            'reason'            => null,
            'remaining_seconds' => null,
            'window_seconds'    => 0,
        ];
    }
}
